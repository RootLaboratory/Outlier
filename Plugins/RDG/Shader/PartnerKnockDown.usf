#include "/Engine/Private/Common.ush"
#include "/Engine/Private/GammaCorrectionCommon.ush"
#include "/Engine/Private/ScreenPass.ush"

// Partner KnockDown. 사망 Noise(DeathNoise.usf)와 같은 무작위 높이 가로 띠 글리치에
// 마스크 패스가 구운 가중치(0~1)를 곱하고, DamageHud 텍스처에도 같은 슬라이스 이동량을 적용한다.
// 사망 Noise와 셰이더를 공유하지 않는다(사망 Noise는 마스크를 쓰지 않음).
// 같은 가중치로 렌즈 CA(UIChromatic.usf 방식)를 장면에 걸고, DamageHud는 펄스 이후 숨쉬기를 한다.

// 슬라이스 시작 줄을 찾으며 거슬러 올라가는 최대 줄 수. 이보다 긴 슬라이스는 여기서 잘린다.
#define MAX_SLICE_SEARCH_ROWS 64

Texture2D InputTexture;
SamplerState InputSampler;

// 샘플링 클램프용. 바이리니어가 뷰 밖을 긁지 않게 반 픽셀 안쪽으로 잡혀 있다.
float2 ViewRectMinUV;
float2 ViewRectMaxUV;

// 텍스처 UV -> 뷰 영역 기준 0~1 UV 변환용.
float2 ViewportUVOrigin;
float2 ViewportUVSize;

// 마스크 패스 결과(뷰 크기 R8G8). R = 글리치 가중치, G = 마스크 밖 가중치(1 - 원본 마스크).
Texture2D WeightTexture;
SamplerState WeightSampler;
int bMaskVisualize;

// DamageHud(straight alpha). 없으면 투명 텍스처가 묶인다.
Texture2D DamageHudTexture;
SamplerState DamageHudSampler;
float3 DamageHudTint;
float DamageHudOpacity;
// pow(Texture, Exponent). 1이면 원본. CPU가 1 / (1 + 진입 펄스값)으로 넣어서 펄스 중에는 1보다 작다(HUD가 진해짐).
float DamageHudExponent;
// AddDarken 덧셈 배율(세기 펄스)과 HUD 아래 장면을 누르는 정도.
float DamageHudIntensity;
float DamageHudDarken;
// 숨쉬기. HUD 색 전체에 같은 값을 곱한다(그라데이션 비율 유지). 1이면 원본.
float DamageHudBreath;
// 0 = AlphaOver, 1 = AddDarken (EPartnerKnockDownDamageHudBlend).
int DamageHudBlendMode;
int bEncodeDamageHudToSRGB;

float Time;
float Intensity;
float Seed;
float SliceRows;
float SliceSplitChance;
float GlitchRate;
float GlitchStrength;
float GlitchThreshold;
float GlitchGlow;
float BurstChance;
float BurstStrength;
float BurstThreshold;
float3 Tint;

// 렌즈 CA(UIChromatic.usf와 같은 방식). ChromaticScale = (R, G) 배율, 0이면 꺼짐. B는 제자리.
float ChromaticStartOffset;
float2 ChromaticScale;
int bChromaticGlitchOnly;

// 채널 순차 복구. 마스크 밖(G)만 흑백에서 시작해 진행도가 각 채널의 시작점을 지날 때 그 채널이 원래 값으로 돌아온다.
// Amount 0이면 꺼짐. Start = (R, G, B) 시작 진행도, Blend = 채널 하나가 켜지는 데 걸리는 진행도 폭.
float ChannelRecoverProgress;
float ChannelRecoverAmount;
float3 ChannelRecoverStart;
float ChannelRecoverBlend;

float Hash11(float X)
{
	return frac(sin(X) * 43758.5453f);
}

// 가중치가 낮을수록(글리치가 약할수록) 빨갛게.
float3 ApplyMaskVisualize(float3 Color, float Weight)
{
	return bMaskVisualize != 0 ? lerp(Color, float3(1.0f, 0.0f, 0.0f), (1.0f - Weight) * 0.5f) : Color;
}

// 아직 켜지지 않은 채널은 휘도로 채운다. 해상도 / 위치는 건드리지 않아 마스크 밖은 선명한 채로 색만 돌아온다.
float3 ApplyChannelRecover(float3 Color, float ClearWeight)
{
	const float Amount = saturate(ChannelRecoverAmount * ClearWeight);
	if (Amount <= 0.0f)
	{
		return Color;
	}

	const float Luma = dot(Color, float3(0.2126f, 0.7152f, 0.0722f));
	const float Blend = max(ChannelRecoverBlend, 1e-4f);
	const float3 Online = smoothstep(ChannelRecoverStart, ChannelRecoverStart + Blend, ChannelRecoverProgress.xxx);
	return lerp(Color, Luma.xxx, Amount * (1.0f - Online));
}

float3 ApplyDamageHud(float3 Color, float2 ViewUV)
{
	if (DamageHudOpacity <= 0.0f)
	{
		return Color;
	}

	float4 Hud = DamageHudTexture.SampleLevel(DamageHudSampler, saturate(ViewUV), 0);
	if (bEncodeDamageHudToSRGB != 0)
	{
		Hud.rgb = LinearToSrgbBranchless(Hud.rgb);
	}
	// 작성한 값 기준으로 지수를 건다(sRGB 보정 뒤).
	Hud = pow(saturate(Hud), max(DamageHudExponent, 0.05f));
	// 숨쉬기: 지수 이후 색에만 같은 값을 곱한다. 알파는 그대로라 Darken 영역은 숨쉬지 않는다.
	Hud.rgb *= saturate(DamageHudBreath);
	const float W = saturate(Hud.a * DamageHudOpacity);

	if (DamageHudBlendMode == 0)
	{
		// AlphaOver: 장면과 HUD 색 사이. 텍스처 색보다 밝아지지 않는다.
		return lerp(Color, Hud.rgb * DamageHudTint, W);
	}

	// AddDarken: HUD 아래 장면을 눌러 어둡게 하고 그 위에 HUD 색을 더한다.
	// 세기가 1을 넘으면 강한 채널(빨강)이 먼저 1에 닿아 채도를 유지한 채 차오른다. Tonemap 이후라 1에서 잘린다.
	const float3 Darkened = Color * (1.0f - W * saturate(DamageHudDarken));
	return saturate(Darkened + Hud.rgb * DamageHudTint * W * max(DamageHudIntensity, 0.0f));
}

void MainPS(
	FScreenVertexOutput Input,
	out float4 OutColor : SV_Target0)
{
	// 슬라이스 / 마스크 / HUD는 뷰 영역 기준 좌표로 계산해야 해상도 스케일 / 뷰 오프셋과 무관해진다.
	const float2 UV = (Input.UV - ViewportUVOrigin) / ViewportUVSize;

	// 가중치 0인 픽셀은 슬라이스 탐색 루프 전에 원본 + HUD로 빠진다.
	const float2 Weights = WeightTexture.SampleLevel(WeightSampler, saturate(UV), 0).rg;
	const float Weight = Weights.r;
	const float ClearWeight = Weights.g;
	if (Weight <= 0.0f || Intensity <= 0.0f)
	{
		const float4 Original = InputTexture.Sample(InputSampler, clamp(Input.UV, ViewRectMinUV, ViewRectMaxUV));
		const float3 Recovered = ApplyChannelRecover(Original.rgb, ClearWeight);
		OutColor = float4(ApplyDamageHud(ApplyMaskVisualize(Recovered, Weight), UV), Original.a);
		return;
	}
	const float WeightedIntensity = Intensity * Weight;

	// 글리치 프레임마다 분할 / 이동 / 버스트를 전부 다시 뽑는다.
	const float GlitchFrame = floor(Time * max(GlitchRate, 1.0f));
	const float FrameSeed = GlitchFrame * 17.17f + Seed * 7.13f;

	// ---------------------------------------------------------
	// Burst
	// ---------------------------------------------------------
	const float Burst = step(1.0f - BurstChance, Hash11(FrameSeed * 3.71f + 0.5f));
	const float StrengthScale = lerp(1.0f, BurstStrength, Burst);
	const float Threshold = lerp(GlitchThreshold, BurstThreshold, Burst);

	// ---------------------------------------------------------
	// Random-height slice
	// ---------------------------------------------------------
	const float Rows = max(floor(SliceRows), 1.0f);
	float SliceStart = min(floor(saturate(UV.y) * Rows), Rows - 1.0f);

	[loop]
	for (int SearchIndex = 0; SearchIndex < MAX_SLICE_SEARCH_ROWS; ++SearchIndex)
	{
		if (SliceStart <= 0.0f || Hash11(SliceStart * 91.73f + FrameSeed) < SliceSplitChance)
		{
			break;
		}
		SliceStart -= 1.0f;
	}

	// ---------------------------------------------------------
	// Per-slice horizontal glitch
	// 가중치는 픽셀별 값이라 X 방향 그라데이션에서는 한 띠 안에서도 이동량이 달라 비스듬히 늘어난다.
	// ---------------------------------------------------------
	const float GlitchGate = step(Threshold, Hash11(SliceStart * 37.19f + FrameSeed * 1.37f));
	const float Direction = Hash11(SliceStart * 53.11f + FrameSeed * 2.71f) * 2.0f - 1.0f;
	const float JitterX = Direction * GlitchStrength * StrengthScale * WeightedIntensity * GlitchGate;

	const float2 SampleUV = clamp(
		Input.UV + float2(JitterX * ViewportUVSize.x, 0.0f),
		ViewRectMinUV,
		ViewRectMaxUV);
	float4 SceneColor = InputTexture.Sample(InputSampler, SampleUV);

	// ---------------------------------------------------------
	// Lens chromatic aberration (UIChromatic.usf와 같은 렌즈 좌표계)
	// 렌즈 위치는 밀리기 전 뷰 UV 기준, 샘플은 글리치로 밀린 위치 기준이라 슬라이스와 함께 움직인다.
	// 가중치를 곱해서 마스크 영역에만 걸리고 회복 순서대로 같이 사라진다.
	// ---------------------------------------------------------
	const float ChromaticWeight = Weight * (bChromaticGlitchOnly != 0 ? GlitchGate : 1.0f);
	if (ChromaticWeight > 0.0f && any(ChromaticScale > 0.0f))
	{
		const float2 LensUV = (saturate(UV) - 0.5f) * 2.0f;
		// 렌즈 좌표 이동량을 뷰 UV(× 0.5) → 텍스처 UV(× ViewportUVSize)로 바꾼다. 가장자리 쪽 값을 중심으로 당겨온다.
		const float2 Pull = -sign(LensUV) * saturate(abs(LensUV) - ChromaticStartOffset)
			* (0.5f * ChromaticWeight) * ViewportUVSize;
		SceneColor.r = InputTexture.Sample(InputSampler, clamp(SampleUV + Pull * ChromaticScale.x, ViewRectMinUV, ViewRectMaxUV)).r;
		SceneColor.g = InputTexture.Sample(InputSampler, clamp(SampleUV + Pull * ChromaticScale.y, ViewRectMinUV, ViewRectMaxUV)).g;
	}

	// 마스크 경계 그라데이션에서는 글리치와 채널 복구가 함께 걸린다. 복구 가중치는 밀리기 전 픽셀 기준.
	const float3 Recovered = ApplyChannelRecover(SceneColor.rgb, ClearWeight);
	const float Glow = saturate(GlitchGate * GlitchGlow * WeightedIntensity);
	const float3 Color = ApplyMaskVisualize(Recovered + Tint * Glow, Weight);

	// HUD는 뷰 영역 기준 UV에 장면과 같은 이동량을 적용해 색과 알파를 함께 이동한다.
	const float2 HudUV = UV + float2(JitterX, 0.0f);
	OutColor = float4(ApplyDamageHud(Color, HudUV), SceneColor.a);
}
