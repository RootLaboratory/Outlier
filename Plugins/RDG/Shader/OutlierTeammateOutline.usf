#include "/Engine/Private/Common.ush"

Texture2D SceneColorTexture;
Texture2D<float> SceneDepthTexture;
Texture2D<float> TargetDepthTexture;
Texture2D<float> FirstPersonDepthTexture;
RWTexture2D<float4> OutputTexture;
// UE의 루트 파라미터 파서가 각 항목을 개별 바인딩하도록 한 선언에 하나씩 둔다.
int2 OutputMin;
int2 OutputSize;
int2 SceneDepthMin;
int2 SceneDepthSize;
int2 MaskMin;
int2 MaskSize;
int2 FirstPersonMin;
int2 FirstPersonSize;
float4 OutlineColor;
float4 Style;
float2 OutputPixelScale;
int DebugMode;

bool HasSurface(float Depth) { return Depth > 0 && Depth < 1.0e7; }
int2 SamplePixel(float2 UV, int2 Min, int2 Size)
{
    return Min + clamp(int2(UV * Size), int2(0, 0), Size - 1);
}
float Target(float2 UV)
{
    if (any(UV < 0) || any(UV >= 1)) return 1.0e8;
    return TargetDepthTexture.Load(int3(SamplePixel(UV, MaskMin, MaskSize), 0));
}
float SceneDepth(float2 UV)
{
    return ConvertFromDeviceZ(SceneDepthTexture.Load(int3(SamplePixel(UV, SceneDepthMin, SceneDepthSize), 0)));
}
float FirstPersonBlock(float2 UV)
{
    float FP = FirstPersonDepthTexture.Load(int3(SamplePixel(UV, FirstPersonMin, FirstPersonSize), 0));
    return HasSurface(FP) ? 1 : 0;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchId : SV_DispatchThreadID)
{
    if (any(DispatchId.xy >= uint2(OutputSize))) return;
    int2 Pixel = OutputMin + DispatchId.xy;
    float4 Scene = SceneColorTexture.Load(int3(Pixel, 0));
    float2 UV = (float2(DispatchId.xy) + 0.5) / OutputSize;
    // Tonemap 입력은 TAA/TSR로 안정화된 화면이다. 원본 깊이·두 마스크를 읽을 때만
    // clip-space jitter를 View UV로 바꿔 더한다. AA를 쓰지 않으면 이 오프셋은 0이다.
    UV += View.TemporalAAJitter.xy * float2(0.5, -0.5);
    float CenterDepth = Target(UV);
    float SourceDepth = 1.0e8;
    float Distance = 1.0e8;
    float2 SourceUV = UV;

    // 가림과 무관한 전체 합집합에서 선을 만든다. 물체가 가로지르는 위치에는 새 선을 만들지 않는다.
    if (!HasSurface(CenterDepth))
    {
        [loop] for (int Y = -4; Y <= 4; ++Y)
        [loop] for (int X = -4; X <= 4; ++X)
        {
            float CandidateDistance = max(length(float2(X, Y)) - 0.5, 0);
            if (CandidateDistance > max(Style.x, Style.y) + 0.5 || CandidateDistance >= Distance) continue;
            float2 CandidateUV = UV + float2(X, Y) * OutputPixelScale / OutputSize;
            float Depth = Target(CandidateUV);
            if (!HasSurface(Depth)) continue;
            Distance = CandidateDistance;
            SourceDepth = Depth;
            SourceUV = CandidateUV;
        }
    }

    float Alpha = 0;
    float Visible = 0;
    float Block = 0;
    if (HasSurface(SourceDepth))
    {
        float Tolerance = max(1.0, SourceDepth * 0.0001);
        float SourceSceneDepth = SceneDepth(SourceUV);
        float OutputSceneDepth = SceneDepth(UV);
        // 벽·소품·다른 Pawn은 모두 같은 가림 정책이다. 가려진 원래 윤곽만 투시 강도로 낮춘다.
        // 선 소스와 출력 위치를 함께 검사해 앞쪽 물체에 강한 선이 번지지 않게 한다.
        Visible = 1 - smoothstep(Tolerance, Tolerance * 2,
            max(SourceDepth - SourceSceneDepth, SourceDepth - OutputSceneDepth));
        float Width = lerp(Style.y, Style.x, Visible);
        Alpha = saturate(Width + 0.5 - Distance) * lerp(Style.w, Style.z, Visible);

        Block = FirstPersonBlock(UV);
        // 실체 안쪽은 완전히 차단하고 바깥 1px만 약하게 확장한다. feather로 무기 위에 선이 새지 않게 한다.
        const float2 Directions[4] = {float2(-1, 0), float2(1, 0), float2(0, -1), float2(0, 1)};
        [unroll] for (int I = 0; I < 4; ++I)
            Block = max(Block, 0.5 * FirstPersonBlock(UV + Directions[I] * OutputPixelScale / OutputSize));
        Alpha *= 1 - Block;
    }

    float3 Result = lerp(Scene.rgb, OutlineColor.rgb, saturate(Alpha));
    if (DebugMode == 1) Result = HasSurface(CenterDepth) ? float3(0, 1, 1) : Scene.rgb * 0.2;
    if (DebugMode == 2) Result = float3(Visible, Block, Alpha);
    if (DebugMode == 3) Result = HasSurface(CenterDepth) ? saturate(log2(1 + CenterDepth) / 16).xxx : float3(0, 0, 0);
    OutputTexture[Pixel] = float4(Result, Scene.a);
}
