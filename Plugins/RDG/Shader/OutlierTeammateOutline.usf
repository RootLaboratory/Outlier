#include "/Engine/Private/Common.ush"

// 가림 집계 엔트리는 터렛 전용이다. 공통 합성은 C++ permutation으로 이 경로를 끈다.
#ifndef HAS_TURRETS
#define HAS_TURRETS 1
#endif

Texture2D SceneColorTexture;
Texture2D<float> SceneDepthTexture;
Texture2D<float> TargetDepthTexture;
Texture2D<float> FirstPersonDepthTexture;
Texture2DArray<float> TurretDepthTexture;
StructuredBuffer<uint> TurretVisibility;
RWStructuredBuffer<uint> OutTurretVisibility;
groupshared uint GroupVisible;
Texture2D<float> CustomDepthTexture;
Texture2D<uint2> CustomStencilTexture;
RWTexture2D<float4> OutputTexture;
// UE의 루트 파라미터 파서가 각 항목을 개별 바인딩하도록 한 선언에 하나씩 둔다.
int2 OutputMin;
int2 OutputSize;
int2 SceneDepthMin;
int2 SceneDepthSize;
int2 MaskMin;
int2 MaskSize;
int2 FirstPersonMin;
int2 FirstPersonSize;
int2 TurretMaskMin;
int2 TurretMaskSize;
int TurretCount;
float4 OutlineColor;
float4 Style;
float4 LegacyStyle;
float2 OutputPixelScale;
int DebugMode;

bool HasSurface(float Depth) { return Depth > 0 && Depth < 1.0e7; }
int2 SamplePixel(float2 UV, int2 Min, int2 Size)
{
    return Min + clamp(int2(UV * Size), int2(0, 0), Size - 1);
}
float Target(float2 UV)
{
    if (any(UV < 0) || any(UV >= 1)) return 1.0e8;
    return TargetDepthTexture.Load(int3(SamplePixel(UV, MaskMin, MaskSize), 0));
}
float SceneDepth(float2 UV)
{
    return ConvertFromDeviceZ(SceneDepthTexture.Load(int3(SamplePixel(UV, SceneDepthMin, SceneDepthSize), 0)));
}
float FirstPersonBlock(float2 UV)
{
    float FP = FirstPersonDepthTexture.Load(int3(SamplePixel(UV, FirstPersonMin, FirstPersonSize), 0));
    return HasSurface(FP) ? 1 : 0;
}

#if HAS_TURRETS
float TurretSlotDepth(float2 UV, int Owner, bool Excluded)
{
    if (any(UV < 0) || any(UV >= 1)) return 1.0e8;
    return TurretDepthTexture.Load(int4(SamplePixel(UV, TurretMaskMin, TurretMaskSize), Owner * 2 + (Excluded ? 1 : 0), 0));
}
bool IsExcludedSurface(float2 UV, int Owner)
{
    // 슬롯 소속은 마스크로 확정한다. 깊이는 두 표면의 앞뒤만 비교하며 오차 범위를 두지 않는다.
    // 정확히 겹친 표면은 제외 슬롯으로 분류한다.
    float Excluded = TurretSlotDepth(UV, Owner, true);
    return HasSurface(Excluded) && Excluded <= TurretSlotDepth(UV, Owner, false);
}
float TurretDepth(float2 UV, int Owner)
{
    // Debug 1의 시안 영역만 선의 입력으로 사용한다. 앞쪽 해치는 제외하되,
    // 주황 영역을 윤곽 탐색에 섞거나 경계 선을 지우는 용도로 확장하지 않는다.
    return IsExcludedSurface(UV, Owner) ? 1.0e8 : TurretSlotDepth(UV, Owner, false);
}

// 해치의 노출은 집계하지 않는다. Body/Head는 같은 Owner 슬라이스에 있으므로 함께 판정한다.
[numthreads(8, 8, 1)]
void TurretVisibilityCS(uint3 DispatchId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
    if (GroupIndex == 0) GroupVisible = 0;
    GroupMemoryBarrierWithGroupSync();
    if (all(DispatchId.xy < uint2(TurretMaskSize)) && DispatchId.z < uint(TurretCount))
    {
        float2 UV = (float2(DispatchId.xy) + 0.5) / TurretMaskSize;
        float Depth = TurretDepth(UV, DispatchId.z);
        if (HasSurface(Depth)
            && abs(Depth - SceneDepth(UV)) <= max(1.0, Depth * 0.0001))
            InterlockedOr(GroupVisible, 1u);
    }
    GroupMemoryBarrierWithGroupSync();
    if (GroupIndex == 0 && GroupVisible != 0) InterlockedOr(OutTurretVisibility[DispatchId.z], 1u);
}

float2 LegacySample(float2 UV)
{
    int2 Pixel = SamplePixel(UV, SceneDepthMin, SceneDepthSize);
    uint Stencil = CustomStencilTexture.Load(int3(Pixel, 0)).g;
    float Custom = ConvertFromDeviceZ(CustomDepthTexture.Load(int3(Pixel, 0)));
    if ((Stencil & 128u) == 0u) return float2(0, Custom);
    float Depth = SceneDepth(UV);
    bool Visible = abs(Custom - Depth) <= max(LegacyStyle.y, Depth * 0.00001);
    uint Scan = Stencil & 3u;
    uint Rank = Visible && ((Stencil & 4u) != 0u) ? 4u :
                Visible && ((Stencil & 8u) != 0u) ? 3u :
                ((Stencil & 32u) != 0u) ? 2u : (Scan == 1u || Scan == 2u ? 1u : 0u);
    return float2(Rank, Custom);
}
bool HasHigherPriorityOutline(float2 UV)
{
    if (LegacyStyle.w == 0 || LegacyStyle.x <= 0) return false;
    float2 Pixel = 1.0 / SceneDepthSize;
    float2 CenterUV = clamp(UV, Pixel * 0.5, 1 - Pixel * 0.5);
    float2 Center = LegacySample(CenterUV);
    float Scene = SceneDepth(CenterUV);
    const float2 Offsets[8] = {float2(-1,0), float2(1,0), float2(0,-1), float2(0,1),
                              float2(-1,-1), float2(-1,1), float2(1,-1), float2(1,1)};
    [unroll] for (int I = 0; I < 8; ++I)
    {
        float2 Neighbor = LegacySample(clamp(CenterUV + Offsets[I] * Pixel * LegacyStyle.x, Pixel * 0.5, 1 - Pixel * 0.5));
        bool Different = Center.x != Neighbor.x ||
            (Center.x > 0 && abs(Center.y - Neighbor.y) > max(LegacyStyle.z, Center.y * 0.001));
        float2 Candidate = Center.x > 0 ? Center : Neighbor;
        if (Different && Candidate.x >= 3 && Candidate.y <= Scene + max(LegacyStyle.y, Scene * 0.00001)) return true;
    }
    return false;
}

// 한 터렛의 해치 구멍을 다른 대상의 차단 마스크로 사용하지 않는다.
bool CoveredByIncludedTarget(float2 UV, float Depth, int Owner)
{
    float PairDepth = Target(UV);
    if (HasSurface(PairDepth) && PairDepth <= Depth) return true;
    [loop] for (int Other = 0; Other < TurretCount; ++Other)
    {
        if (Other == Owner) continue;
        float OtherDepth = TurretDepth(UV, Other);
        if (HasSurface(OtherDepth) && OtherDepth <= Depth) return true;
    }
    return false;
}
#endif

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchId : SV_DispatchThreadID)
{
    if (any(DispatchId.xy >= uint2(OutputSize))) return;
    int2 Pixel = OutputMin + DispatchId.xy;
    float4 Scene = SceneColorTexture.Load(int3(Pixel, 0));
    float2 UV = (float2(DispatchId.xy) + 0.5) / OutputSize;
    // Tonemap 입력은 TAA/TSR로 안정화된 화면이다. 원본 깊이·두 마스크를 읽을 때만
    // clip-space jitter를 View UV로 바꿔 더한다. AA를 쓰지 않으면 이 오프셋은 0이다.
    UV += View.TemporalAAJitter.xy * float2(0.5, -0.5);
    float CenterDepth = Target(UV);
    float SourceDepth = 1.0e8;
    float Distance = 1.0e8;
    float2 SourceUV = UV;

    // 가림과 무관한 전체 합집합에서 선을 만든다. 물체가 가로지르는 위치에는 새 선을 만들지 않는다.
    if (!HasSurface(CenterDepth))
    {
        [loop] for (int Y = -4; Y <= 4; ++Y)
        [loop] for (int X = -4; X <= 4; ++X)
        {
            float CandidateDistance = max(length(float2(X, Y)) - 0.5, 0);
            if (CandidateDistance > max(Style.x, Style.y) + 0.5 || CandidateDistance >= Distance) continue;
            float2 CandidateUV = UV + float2(X, Y) * OutputPixelScale / OutputSize;
            float Depth = Target(CandidateUV);
            if (!HasSurface(Depth)) continue;
            Distance = CandidateDistance;
            SourceDepth = Depth;
            SourceUV = CandidateUV;
        }
    }

    float Alpha = 0;
    float Visible = 0;
    float Block = 0;
    if (HasSurface(SourceDepth))
    {
        float Tolerance = max(1.0, SourceDepth * 0.0001);
        float SourceSceneDepth = SceneDepth(SourceUV);
        float OutputSceneDepth = SceneDepth(UV);
        // 벽·소품·다른 Pawn은 모두 같은 가림 정책이다. 가려진 원래 윤곽만 투시 강도로 낮춘다.
        // 선 소스와 출력 위치를 함께 검사해 앞쪽 물체에 강한 선이 번지지 않게 한다.
        Visible = 1 - smoothstep(Tolerance, Tolerance * 2,
            max(SourceDepth - SourceSceneDepth, SourceDepth - OutputSceneDepth));
        float Width = lerp(Style.y, Style.x, Visible);
        Alpha = saturate(Width + 0.5 - Distance) * lerp(Style.w, Style.z, Visible);

        Block = FirstPersonBlock(UV);
        // 실체 안쪽은 완전히 차단하고 바깥 1px만 약하게 확장한다. feather로 무기 위에 선이 새지 않게 한다.
        const float2 Directions[4] = {float2(-1, 0), float2(1, 0), float2(0, -1), float2(0, 1)};
        [unroll] for (int I = 0; I < 4; ++I)
            Block = max(Block, 0.5 * FirstPersonBlock(UV + Directions[I] * OutputPixelScale / OutputSize));
        Alpha *= 1 - Block;
    }

#if HAS_TURRETS
    // pair의 소스 선택과 FP 처리는 그대로 둔다. 터렛은 같은 합성 안에서 대상별 후보만 추가한다.
    float BestSourceDepth = SourceDepth;
    bool ProtectLegacy = TurretCount > 0 && HasHigherPriorityOutline(UV);
    [loop] for (int Owner = 0; Owner < TurretCount; ++Owner)
    {
        float TurretCenter = TurretDepth(UV, Owner);
        if (HasSurface(TurretCenter) || ProtectLegacy) continue;
        float TurretSourceDepth = 1.0e8;
        float TurretDistance = 1.0e8;
        float2 TurretSourceUV = UV;
        [loop] for (int Y = -4; Y <= 4; ++Y)
        [loop] for (int X = -4; X <= 4; ++X)
        {
            float CandidateDistance = max(length(float2(X, Y)) - 0.5, 0);
            if (CandidateDistance > max(Style.x, Style.y) + 0.5) continue;
            float2 CandidateUV = UV + float2(X, Y) * OutputPixelScale / OutputSize;
            float Depth = TurretDepth(CandidateUV, Owner);
            if (!HasSurface(Depth)) continue;
            if (CandidateDistance > TurretDistance) continue;
            // 후보는 모두 시안 영역이다. 화면 거리가 같으면 앞쪽 본체 표면을 선택한다.
            if (CandidateDistance == TurretDistance && Depth >= TurretSourceDepth) continue;
            TurretDistance = CandidateDistance;
            TurretSourceDepth = Depth;
            TurretSourceUV = CandidateUV;
        }
        // 시안 영역 자체의 윤곽을 그린다. 해치와 맞닿은 경계도 본체의 윤곽에 포함한다.
        if (!HasSurface(TurretSourceDepth)
            || CoveredByIncludedTarget(UV, TurretSourceDepth, Owner)) continue;
        float Tolerance = max(1.0, TurretSourceDepth * 0.0001);
        float TurretVisible = 1 - smoothstep(Tolerance, Tolerance * 2,
            max(TurretSourceDepth - SceneDepth(TurretSourceUV), TurretSourceDepth - SceneDepth(UV)));
        // 완전 가림이면 전체 투시 윤곽을 보여준다. 부분 가림일 때만 가려진 소스를 흐리게 한다.
        float StrengthVisibility = TurretVisibility[Owner] == 0 ? 1 : TurretVisible;
        float Width = lerp(Style.y, Style.x, StrengthVisibility);
        float TurretAlpha = saturate(Width + 0.5 - TurretDistance) * lerp(Style.w, Style.z, StrengthVisibility);
        float TurretBlock = FirstPersonBlock(UV);
        const float2 Directions[4] = {float2(-1,0), float2(1,0), float2(0,-1), float2(0,1)};
        [unroll] for (int I = 0; I < 4; ++I)
            TurretBlock = max(TurretBlock, 0.5 * FirstPersonBlock(UV + Directions[I] * OutputPixelScale / OutputSize));
        TurretAlpha *= 1 - TurretBlock;
        if (TurretAlpha > Alpha || (TurretAlpha == Alpha && TurretSourceDepth < BestSourceDepth))
        {
            Alpha = TurretAlpha;
            Visible = TurretVisible;
            Block = TurretBlock;
            BestSourceDepth = TurretSourceDepth;
        }
    }

#endif
    // 디버그 커버리지는 제외 표면을 별도 색으로 표시하여 슬롯 매핑과 좌표 정렬을 확인한다.
    float3 DebugCoverage = HasSurface(CenterDepth) ? float3(0, 1, 1) : Scene.rgb * 0.2;
#if HAS_TURRETS
    [loop] for (int Owner = 0; Owner < TurretCount; ++Owner)
    {
        // 디버그 색은 기존대로 유지해 실제 선의 입력(시안)과 제외 영역(주황)을 대조한다.
        float Depth = min(TurretSlotDepth(UV, Owner, false), TurretSlotDepth(UV, Owner, true));
        if (!HasSurface(Depth)) continue;
        DebugCoverage = IsExcludedSurface(UV, Owner) ? float3(1, 0.2, 0) : float3(0, 1, 1);
        if (!HasSurface(CenterDepth) || Depth < CenterDepth) CenterDepth = Depth;
    }
#endif

    float3 Result = lerp(Scene.rgb, OutlineColor.rgb, saturate(Alpha));
    if (DebugMode == 1) Result = DebugCoverage;
    if (DebugMode == 2) Result = float3(Visible, Block, Alpha);
    if (DebugMode == 3) Result = HasSurface(CenterDepth) ? saturate(log2(1 + CenterDepth) / 16).xxx : float3(0, 0, 0);
    OutputTexture[Pixel] = float4(Result, Scene.a);
}
