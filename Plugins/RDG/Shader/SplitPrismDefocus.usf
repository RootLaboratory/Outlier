#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

// Split Prism 디포커스. Tonemap 앞(선형 HDR)이라 밝은 점이 빛망울로 퍼진다.
// 평면 피사체 가정: 화면 전체가 같은 디포커스 d를 가진다. G 반경 = MaxRadius × |d|.
// - 색 번짐: R/B 반경이 G의 (1 + FringeAmount × sign(d))배.
//   앞초점은 R/B가 G보다 바깥까지 번져 보라 테두리, 뒤초점은 G만 바깥에 남아 초록 테두리.
// - 테두리 밝기: 앞초점은 원판 바깥쪽, 뒤초점은 가운데 샘플 가중치를 올린다.
// - 샘플 하나가 맡는 면적만큼 미리 흐린 밉을 읽는다. 원판이 여러 장 겹쳐 찍힌 것처럼 보이지 않게 하려는 것이고,
//   커널 모양은 그대로 원판이다.
// - 깊이 잔차: 갈라짐은 원래 픽셀마다 1/D - 1/F에 비례한다. 화면 전체 몫 d(t)는 Slate 이후 SplitPrism.usf가 HUD까지 민다.
//   여기서는 장면에만 피사체와의 깊이 차이 몫 r = (1/D_subj - 1/D) / Δ 만큼 더 민다. 장면 총 갈라짐 = StartOffset × (d + r).
//   가까운 물체는 r < 0이라 반대 방향, 먼 물체는 r > 0. 오프셋은 도착 픽셀의 깊이로 정한다(깊이 경계에서 약간 늘어날 수 있음).

Texture2D InputTexture;     // 뷰 크기, 밉 체인 있음
SamplerState InputSampler;  // 트라이리니어

float2 InputTexelSize;      // 1 / 뷰 크기
float Defocus;
float MaxRadius;            // 현재 해상도 기준 px
float FringeAmount;
float RimBias;
uint SampleCount;
float MaxMipLevel;

// 깊이 잔차
Texture2D SceneDepthTexture;
SamplerState DepthSampler;          // 포인트
float2 DepthUVScale;                // 뷰 UV(0~1) → 깊이 텍스처 UV. 깊이는 렌더 해상도 ViewRect 기준.
float2 DepthUVBias;
float4 InvDeviceZToWorldZTransform;
float DepthOffset;                  // StartOffset. r = 1일 때 화면 높이 대비 오프셋
float InvSubjectDistance;           // 1/D_subj (1/m)
float InvFocusSwing;                // 1/Δ (m). Δ = 시작 시 초점이 빗나간 정도(디옵터)
float MaxResidual;                  // |r| 상한. 렌즈 바로 앞 물체가 끝없이 갈라지지 않게
float ResidualWeight;               // 0~1. 0이면 잔차 끔 (Settle 페이드에 사용)

static const float GoldenAngle = 2.39996323f;

// DeviceZ → 뷰 공간 깊이(cm). ADSWeaponBlur.usf와 같은 식.
float LinearizeSceneDepth(float DeviceZ)
{
	return DeviceZ * InvDeviceZToWorldZTransform.x
		+ InvDeviceZToWorldZTransform.y
		+ 1.0f / (DeviceZ * InvDeviceZToWorldZTransform.z - InvDeviceZToWorldZTransform.w);
}

// 피사체와의 깊이 차이 몫 r. 부호는 d와 같은 규약(+ = 시작 방향).
float ComputeDepthResidual(float2 ViewUV)
{
	const float DeviceZ = SceneDepthTexture.SampleLevel(DepthSampler, ViewUV * DepthUVScale + DepthUVBias, 0).r;
	// Reversed-Z: DeviceZ = 0은 무한히 먼 곳(하늘). 1/D = 0.
	const float InvDepth = DeviceZ > 0.0f
		? rcp(max(LinearizeSceneDepth(DeviceZ) * 0.01f, 0.01f))
		: 0.0f;
	return clamp((InvSubjectDistance - InvDepth) * InvFocusSwing, -MaxResidual, MaxResidual);
}

void MainPS(
	FScreenVertexOutput Input,
	out float4 OutColor : SV_Target0)
{
	const float2 MinUV = 0.5f * InputTexelSize;
	const float2 MaxUV = 1.0f - 0.5f * InputTexelSize;
	float2 UV = clamp(Input.UV, MinUV, MaxUV);

	// 깊이 잔차만큼 세로로 민다. SplitPrism.usf와 같은 부호: 왼쪽은 -Offset을 더해 아래로 밀린 것처럼 보인다.
	if (ResidualWeight > 0.0f)
	{
		const float Residual = ComputeDepthResidual(UV) * ResidualWeight;
		const float Side = UV.x < 0.5f ? -1.0f : 1.0f;
		UV.y = clamp(UV.y + Side * DepthOffset * Residual, MinUV.y, MaxUV.y);
	}

	const float4 Center = InputTexture.SampleLevel(InputSampler, UV, 0);

	const float FocusSign = Defocus >= 0.0f ? 1.0f : -1.0f;
	const float RadiusG = MaxRadius * abs(Defocus);
	const float RadiusRB = RadiusG * (1.0f + FringeAmount * FocusSign);
	const float3 Radius = float3(RadiusRB, RadiusG, RadiusRB);
	const float SampleRadius = max(RadiusG, RadiusRB);

	if (SampleRadius < 0.5f)
	{
		OutColor = Center;
		return;
	}

	const uint Count = max(SampleCount, 1u);
	// 샘플 하나가 맡는 원판 면적의 한 변(px). 이 크기로 미리 흐린 밉을 읽는다.
	const float TapSpacing = SampleRadius * sqrt(PI / Count);
	const float MipLevel = clamp(log2(max(TapSpacing, 1.0f)), 0.0f, MaxMipLevel);

	float3 ColorSum = 0.0f;
	float3 WeightSum = 0.0f;

	LOOP
	for (uint Index = 0; Index < Count; ++Index)
	{
		// Vogel 원판: 반지름을 sqrt로 늘려 면적이 고르게 나뉜다.
		const float Rho = sqrt((Index + 0.5f) / Count) * SampleRadius;
		const float Theta = Index * GoldenAngle;
		const float2 SampleUV = clamp(
			UV + float2(cos(Theta), sin(Theta)) * Rho * InputTexelSize,
			MinUV,
			MaxUV);
		const float3 SampleColor = InputTexture.SampleLevel(InputSampler, SampleUV, MipLevel).rgb;

		// 채널마다 자기 반경 안의 샘플만 쓴다. 경계는 샘플 간격만큼 부드럽게.
		const float3 Inside = saturate((Radius - Rho) / TapSpacing + 0.5f);
		const float3 RimT = saturate(Rho / max(Radius, 1e-3f));
		const float3 Rim = max(1.0f + RimBias * FocusSign * (2.0f * RimT - 1.0f), 0.0f);
		const float3 Weight = Inside * Rim;

		ColorSum += SampleColor * Weight;
		WeightSum += Weight;
	}

	// 반경이 너무 작아 샘플이 하나도 안 들어간 채널은 원본을 쓴다.
	const float3 HasWeight = step(1e-4f, WeightSum);
	const float3 Blurred = ColorSum / max(WeightSum, 1e-4f);
	OutColor = float4(lerp(Center.rgb, Blurred, HasWeight), Center.a);
}
